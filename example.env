# Copy this file:
#   cp example.env .env
#   cp example.env backend/.env
# Then fill in Stripe and Cloudinary keys below.

# ── Database ──────────────────────────────────────────────
DB_DIALECT=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DB=appointy
# Production always checks SequelizeMeta and refuses to start if migrations are
# pending (sequelize.sync is never used as a production migration strategy).
# Set true in any environment that applies schema via `npm run db:migrate`.
USE_MIGRATIONS=false

# ── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# JWT — separate secrets per actor (do not share one secret across roles)
JWT_SECRET=your_jwt_secret_key_here
JWT_PATIENT_SECRET=your_patient_jwt_secret_here
JWT_DOCTOR_SECRET=your_doctor_jwt_secret_here
JWT_ADMIN_SECRET=your_admin_jwt_secret_here
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=30d
JWT_ACCEPT_LEGACY=true

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend URL (password reset emails + Stripe return URLs)
FRONTEND_URL=http://localhost:5173

# Clinic scheduling timezone (IANA). Slot hours 10:00–21:00 are in this zone.
SCHEDULING_TIMEZONE=Asia/Karachi

# ── Cloudinary (required for all image uploads) ──────────
# Dashboard: https://console.cloudinary.com → API Keys
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Stripe (Checkout payments) ───────────────────────────
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# From Stripe CLI (`stripe listen`) or Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
CURRENCY=pkr
MIN_APPOINTMENT_FEE=100
MAX_APPOINTMENT_FEE=1000000

# Checkout session expiry (minutes). Stripe clamps to 31–1440.
STRIPE_CHECKOUT_EXPIRY_MINUTES=60
# Server-owned PENDING_PAYMENT slot hold (minutes). Independent of Stripe —
# abandoned / failed checkout attempts release when this deadline passes.
APPOINTMENT_HOLD_EXPIRY_MINUTES=60
# In-process worker that cancels expired payment holds (default: on outside tests).
# PAYMENT_HOLD_WORKER_ENABLED=true
# PAYMENT_HOLD_WORKER_INTERVAL_MS=60000

# Frontend / Admin (Docker / production build args — required browser-reachable API URL)
# Local npm run dev: leave empty in frontend/.env and admin/.env to use the Vite /api proxy
VITE_BACKEND_URL=http://localhost:4000
VITE_CURRENCY=PKR
VITE_PATIENT_URL=http://localhost:5173

# ── Email (optional — logs to console if not set) ────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# Copy this file:
#   cp example.env .env
#   cp example.env backend/.env
# Then fill in Stripe and Cloudinary keys below.

# ── Database ──────────────────────────────────────────────
DB_DIALECT=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DB=appointy
USE_MIGRATIONS=false

# ── Server ───────────────────────────────────────────────
PORT=4000
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend URL (password reset emails + Stripe return URLs)
FRONTEND_URL=http://localhost:5173

# ── Cloudinary (required for all image uploads) ──────────
# Dashboard: https://console.cloudinary.com → API Keys
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Stripe (Checkout payments) ───────────────────────────
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
CURRENCY=pkr

# Frontend / Admin (Docker build args — browser-reachable API URL)
VITE_BACKEND_URL=http://localhost:4000
VITE_CURRENCY=PKR
VITE_PATIENT_URL=http://localhost:5173

# ── Email (optional — logs to console if not set) ────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

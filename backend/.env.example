# Copy from repo root: cp example.env backend/.env
# Then fill in Stripe and Cloudinary keys.

# ── Database ──────────────────────────────────────────────
DB_DIALECT=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DB=appointy
USE_MIGRATIONS=false

# ── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# JWT — use separate secrets per actor (required in production).
# JWT_SECRET is only a legacy/dev fallback used to derive role secrets
# and optionally accept pre-migration tokens when JWT_ACCEPT_LEGACY=true.
JWT_SECRET=your_jwt_secret_key_here
JWT_PATIENT_SECRET=your_patient_jwt_secret_here
JWT_DOCTOR_SECRET=your_doctor_jwt_secret_here
JWT_ADMIN_SECRET=your_admin_jwt_secret_here
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=30d
# Accept old {id}-only tokens during migration (default: true outside production)
JWT_ACCEPT_LEGACY=true

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend URL (password reset emails + Stripe return URLs)
FRONTEND_URL=http://localhost:5173

# ── Cloudinary (required for all image uploads) ──────────
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Stripe (Checkout payments) ───────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
CURRENCY=pkr
MIN_APPOINTMENT_FEE=100
MAX_APPOINTMENT_FEE=1000000

# Refund policy (hours before appointment start)
FULL_REFUND_HOURS=24
PARTIAL_REFUND_HOURS=2
PARTIAL_REFUND_PERCENT=50

# ── Email (optional) ─────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
